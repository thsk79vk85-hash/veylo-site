# Use credentials from a NEW, waitlist-only Supabase project.
# Never reuse the Veylo app Supabase URL or service-role key.
WAITLIST_SUPABASE_URL=https://your-waitlist-project.supabase.co
WAITLIST_SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Server-only Resend credentials for one-time waitlist confirmations.
RESEND_API_KEY=
WAITLIST_FROM_EMAIL=Veylo <hello@example.com>

# Server-only launch v1 keys: independently generated and distinct from each
# other and SIGNUP_RATE_SECRET. Names only; never put actual keys in this file.
SIGNUP_LAUNCH_MATCH_SECRET=
SIGNUP_LAUNCH_TOKEN_SECRET=
# Keep disabled until guarded current launch routes AND historical unsafe-writer
# controls/in-flight settlement are verified (Tasks 3/5). No public promise yet.
SIGNUP_LAUNCH_UNSUBSCRIBE_ENABLED=false
# Guarded launch intake stays OFF until historical writers are controlled.
SIGNUP_LAUNCH_ENABLED=false
# Key replacement is not a routine env edit: preserve suppression matching,
# pinned retry bodies and existing usable links. Rotation needs a reviewed
# versioned transition/retention decision; never overwrite active keys blindly.
